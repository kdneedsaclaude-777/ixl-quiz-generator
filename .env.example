# QuizSpark environment. Copy to .env and fill in. (Do not commit real secrets.)

# Database
DATABASE_URL="file:./dev.db"

# Auth (NextAuth)
NEXTAUTH_SECRET="<random-long-secret>"
NEXTAUTH_URL="http://localhost:3000"

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="QuizSpark <no-reply@quizly.app>"

# ── Web Push (VAPID) — phone push notifications ─────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Public key must be set in BOTH VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# VAPID_PUBLIC_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@conceptmastery.ca

# Email provider switch. Unset/"auto" = use Resend if RESEND_API_KEY is set,
# else SMTP. Set EMAIL_PROVIDER=smtp (or "gmail") to MUTE Resend and force
# Gmail/SMTP even if a Resend key is present (reversible — no need to delete it).
# EMAIL_PROVIDER=smtp

# AI (optional; defaults to the mock generator)
# AI_PROVIDER="claude"                       # set to "claude" to use live generation for adaptive quizzes
# ANTHROPIC_API_KEY="sk-ant-..."             # also powers the /admin/import PDF→questions generator
# CLAUDE_MODEL="claude-..."

# ── Billing master switch ───────────────────────────────────────────────────
# false = ship a FREE build (all features unlocked, paywalls/upgrade UI hidden,
#         checkout/portal disabled). true/unset = paid $5/mo model.
# The Stripe vars below are only needed when this is true.
# NEXT_PUBLIC_BILLING_ENABLED=false

# ── Stripe billing (QuizSpark Plus, $5/mo) ──────────────────────────────────
# Required for real payments. Use LIVE keys for the shipped build.
STRIPE_SECRET_KEY="sk_live_..."            # Stripe → Developers → API keys
STRIPE_PRICE_ID="price_..."                # a RECURRING $5/month price (QuizSpark Plus product)
STRIPE_WEBHOOK_SECRET="whsec_..."          # from the webhook endpoint → /api/billing/webhook
NEXT_PUBLIC_APP_URL="https://app.quizly.app"  # public origin for checkout redirects

# Optional growth levers (leave unset to keep the plain $5/mo plan):
# STRIPE_PRICE_ID_ANNUAL="price_..."         # a RECURRING annual price → enables the Monthly/Yearly toggle
# STRIPE_TRIAL_DAYS="7"                       # free-trial length on new subs (0/unset = no trial)

# Local-only dry run of the upgrade flow WITHOUT Stripe keys. Leave UNSET in
# production — when unset (or when keys are present) only real Stripe is used.
# BILLING_DEV_SIMULATE="1"

# ── Scheduled emails (cron → /api/cron/notifications) ───────────────────────
CRON_SECRET="<random-long-secret>"         # Bearer token the cron job sends
# STREAK_REMINDER_MIN_DAYS="1"               # only nudge streaks at least this long (default 1)
