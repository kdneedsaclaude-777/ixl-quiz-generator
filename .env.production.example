# ---------------------------------------------------------------------------
# Production environment template. Copy to .env (or set these in your host's
# secret manager) and fill in real values. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Postgres connection string. Run `npm run db:use-postgres` first so the
# Prisma datasource provider matches, then `npx prisma migrate deploy`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ixlquiz?schema=public&sslmode=require"

# NextAuth — MUST be a strong random secret and the real public URL.
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://quiz.example.com"

# Live model is opt-in; omit AI_PROVIDER to keep the deterministic mock.
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-7

# Real SMTP. When SMTP_HOST + SMTP_USER + SMTP_PASS are all set, email is
# sent via this transport; otherwise the app falls back to an Ethereal test
# inbox (dev only). EMAIL_FROM defaults to SMTP_USER if unset.
SMTP_HOST="smtp.postmarkapp.com"
SMTP_PORT="587"
SMTP_SECURE="false"            # "true" for port 465
SMTP_USER="apikey-or-username"
SMTP_PASS="smtp-password"
EMAIL_FROM="IXL Quiz <no-reply@quiz.example.com>"

# Alternatively, Resend (https://resend.com) — takes priority over SMTP when
# set. Use a verified-domain sender in EMAIL_FROM to deliver to any inbox.
# RESEND_API_KEY="re_xxxxxxxx"

# Public test/staging only: auto-verify new signups (no email needed).
# NEVER set this in real production.
# PUBLIC_TEST_MODE=true

# Shared secret for POST /api/cron/notifications (fail-closed if unset).
CRON_SECRET="replace-with-a-long-random-string"
