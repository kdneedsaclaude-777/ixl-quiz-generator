generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================================
// Auth + roles (NextAuth v4 + Prisma adapter conventions)
// =====================================================================

// Tenant boundary. Every parent/tutor/orgadmin/student belongs to exactly
// one Organization. The platform `superadmin` has orgId = null and sees all
// orgs.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users     User[]
  students  Student[]
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String
  passwordHash         String?
  // 'student' | 'parent' | 'tutor' | 'orgadmin' | 'superadmin'
  role                 String                @default("parent")
  orgId                String?
  organization         Organization?         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  emailVerified        DateTime?
  // Optional secondary channel; verified separately via SMS code (see
  // PhoneVerification). E.164 format, nullable.
  phone                String?
  phoneVerified        DateTime?
  suspendedAt          DateTime?
  deletedAt            DateTime?
  darkMode             Boolean               @default(false)
  lastLoginAt          DateTime?
  createdAt            DateTime              @default(now())

  // ── Subscription / freemium (Quizly) ──────────────────────────────────
  // The consumer plan lives on the parent account. "free" = 1 lifetime quiz +
  // practice only; "paid" = $5/mo unlocks everything. Stripe is the source of
  // truth; the webhook flips `plan` + status. Other roles default to "free"
  // but plan gating is only enforced for parents.
  plan                 String                @default("free") // "free" | "paid"
  stripeCustomerId     String?               @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?               // Stripe sub status (active, canceled, past_due…)
  currentPeriodEnd     DateTime?             // paid access valid through this

  // Parental profile-lock: a 4-digit PIN (bcrypt-hashed) the parent sets so a
  // kid on a shared device can't switch profiles or reach the parent app.
  // Null = no lock. Emailed to the parent when set/resent.
  profileLockPin       String?

  students             Student[]             @relation("ParentStudents")
  studentProfile       Student?              @relation("StudentAccount")
  tutorAssignments     TutorAssignment[]     @relation("TutorLink")
  notificationSettings NotificationSettings?
  payments             Payment[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  accounts             Account[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  phoneVerification    PhoneVerification?
  auditEntries              AuditLog[]                @relation("AuditActor")
  conversationParticipants  ConversationParticipant[]
  sentMessages              Message[]                 @relation("MessageSender")
  tutorSessions             TutorSession[]            @relation("TutorSessions")
  tutorHomework             HomeworkAssignment[]      @relation("TutorHomework")

  @@index([orgId])
  @@index([role])
}

// Links a tutor (User role=tutor) to a student they oversee. Assignment is
// performed by an org-admin or superadmin.
model TutorAssignment {
  id        String   @id @default(cuid())
  tutorId   String
  tutor     User     @relation("TutorLink", fields: [tutorId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tutorId, studentId])
  @@index([studentId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One pending phone-verification per user — re-requesting overwrites the
// previous code. Phone is captured here so a number change can't be activated
// by a stale code issued for the old number.
model PhoneVerification {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  code      String   // 6-digit; short TTL + attempt cap make hashing unnecessary
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

// =====================================================================
// Curriculum + students
// =====================================================================

model Student {
  id                Int                      @id @default(autoincrement())
  name              String
  grade             Int
  avatar            String?                  // kid-chosen emoji avatar; falls back to a derived one
  dailyGoal         Int                      @default(1) // target quizzes/day (kid home progress)
  currentDifficulty Int                      @default(1)
  tutorApproved     Boolean                  @default(true)
  orgId             String?
  organization      Organization?            @relation(fields: [orgId], references: [id], onDelete: SetNull)
  parentId          String?
  parent            User?                    @relation("ParentStudents", fields: [parentId], references: [id], onDelete: SetNull)
  // The student's own login account (User role=student). Null if the student
  // is purely parent-managed and has no direct login yet.
  userId            String?                  @unique
  account           User?                    @relation("StudentAccount", fields: [userId], references: [id], onDelete: SetNull)
  xp                Int                      @default(0)
  level             Int                      @default(1)
  createdAt         DateTime                 @default(now())
  topicSelections   StudentTopicSelection[]
  quizzes           Quiz[]
  attempts          Attempt[]
  conceptMastery    ConceptMastery[]
  parentalSettings  ParentalSettings?
  earnedBadges      StudentBadge[]
  xpLog             XPLog[]
  tutorAssignments  TutorAssignment[]
  conversations     Conversation[]
  tutorSessions     TutorSession[]
  homework          HomeworkAssignment[]
  claimCode         StudentClaimCode?

  @@index([orgId])
  @@index([parentId])
}

model TopicGroup {
  id              Int                      @id @default(autoincrement())
  gradeLevel      Int
  letter          String
  name            String
  active          Boolean                  @default(true)
  skills          Skill[]
  studentSelected StudentTopicSelection[]

  @@unique([gradeLevel, letter])
}

model Skill {
  id           Int             @id @default(autoincrement())
  topicGroupId Int
  topicGroup   TopicGroup      @relation(fields: [topicGroupId], references: [id])
  code         String
  number       Int
  name         String
  active       Boolean         @default(true)
  questions    Question[]
  mastery      ConceptMastery[]

  @@unique([topicGroupId, number])
  // Generation maps question skill_codes back to rows via `code IN (...)`.
  @@index([code])
}

model StudentTopicSelection {
  id           Int        @id @default(autoincrement())
  studentId    Int
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicGroupId Int
  topicGroup   TopicGroup @relation(fields: [topicGroupId], references: [id])

  @@unique([studentId, topicGroupId])
}

model Quiz {
  id          Int        @id @default(autoincrement())
  studentId   Int
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      String     @default("active")
  score       Float?
  difficulty  Int
  // "practice" (default, step-by-step feedback) | "test" (proctored: answers
  // and explanations are withheld until the quiz is submitted / unlocked).
  mode        String     @default("practice")
  // "adaptive" (one-tap, engine-chosen) | "manual" (parent/tutor builder).
  generatedBy String     @default("adaptive")
  // JSON snapshot of the manual builder params {topicGroupIds,difficulty,
  // questionCount,mode} for reproducibility/audit. Null for adaptive quizzes.
  paramsJson  String?
  // Test-mode timing. timeLimitSec null = untimed. timeUsedSec filled on submit.
  timeLimitSec Int?
  timeUsedSec  Int?
  // Stamped ONCE when a test is first started, so reloading the intake can't
  // reset the countdown. The authoritative clock origin (falls back to
  // startedAt for legacy rows).
  testStartedAt DateTime?
  // Parent/tutor gate: test answers + explanations stay hidden on the result
  // screen until this is flipped true.
  reviewUnlocked Boolean  @default(false)
  // JSON int[] of Question ids the student flagged for review during a test.
  flaggedQuestionIds String @default("[]")
  // True only for the home "Daily Challenge" tile's quiz — powers the
  // daily_done badge + daily-challenge XP bonus. Server-set, never trusted
  // from the client.
  isDailyChallenge Boolean @default(false)
  startedAt   DateTime   @default(now())
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  questions   Question[]
  xpLogs      XPLog[]

  @@index([studentId, mode])
  // Hot: child home + history + last-quiz + count-today all filter by student +
  // status and order by completedAt.
  @@index([studentId, status])
  @@index([studentId, completedAt])
}

model Question {
  id                  Int       @id @default(autoincrement())
  quizId              Int
  quiz                Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  skillId             Int
  skill               Skill     @relation(fields: [skillId], references: [id])
  position            Int
  difficulty          Int
  questionType        String
  questionStyle       String
  questionText        String
  answerOptionsJson   String
  correctAnswer       String
  displayLabel        String
  learningObjective   String
  conceptTagsJson     String
  explanationJson     String
  needsVisual         Boolean   @default(false)
  visualNote          String?
  visualSvg           String?
  toneGrade           Int
  estimatedComplexity String
  weakSkillTargeted   Boolean   @default(false)
  remediationFlag     Boolean   @default(false)
  needsReview         Boolean   @default(false)
  attempts            Attempt[]

  // Questions are loaded by quiz on every quiz/results render, and by skill for
  // mastery rollups. Postgres doesn't auto-index FKs — add them explicitly.
  @@index([quizId])
  @@index([skillId])
}

model Attempt {
  id             Int      @id @default(autoincrement())
  questionId     Int
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentId      Int
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  selectedAnswer String
  isCorrect      Boolean
  createdAt      DateTime @default(now())

  // Grading + "has this quiz been started?" checks filter by question; progress
  // views filter by student.
  @@index([questionId])
  @@index([studentId])
}

model ConceptMastery {
  id                 Int      @id @default(autoincrement())
  studentId          Int
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId            Int
  skill              Skill    @relation(fields: [skillId], references: [id])
  consecutiveCorrect Int      @default(0)
  totalAttempts      Int      @default(0)
  totalCorrect       Int      @default(0)
  failedQuizzes      Int      @default(0)
  remediationFlag    Boolean  @default(false)
  lastDifficulty     Int      @default(1)
  lastQuizScore      Float?
  progressionNote    String?
  updatedAt          DateTime @updatedAt @default(now())

  @@unique([studentId, skillId])
}

// Internal key/value store for the ops console (deliberately NOT surfaced in the
// admin UI). Used for global switches. Reads are defensive so a missing table
// (pre-migration) never breaks the app.
model OwnerSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @default(now())
}

model VideoResource {
  id               Int      @id @default(autoincrement())
  subject          String
  gradeMin         Int
  gradeMax         Int
  topicGroupLetter String
  skillCode        String?
  title            String
  provider         String
  url              String
  description      String
  qualityScore     Int      @default(5)
  createdAt        DateTime @default(now())

  @@index([subject, gradeMin, gradeMax])
  @@index([topicGroupLetter])
}

// =====================================================================
// Parental controls + notifications
// =====================================================================

model ParentalSettings {
  studentId           Int      @id
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  maxQuizzesPerDay    Int?
  windowStart         String?  // "16:00" — wall-clock in windowTimezone
  windowEnd           String?  // "20:00" — wall-clock in windowTimezone
  // IANA timezone the window times are expressed in (e.g. "America/New_York").
  // Captured from the parent's browser on save; null on legacy rows.
  windowTimezone      String?
  lockedTopicGroupIds String   @default("[]") // JSON array of TopicGroup ids
  updatedAt           DateTime @updatedAt
}

model NotificationSettings {
  userId              String  @id
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEveryQuiz      Boolean @default(false)
  weeklyDigest        Boolean @default(true)
  alertBelowScorePct  Int?    @default(60)
  alertNoPracticeDays Int?    @default(7)
  streakReminder      Boolean @default(true)
}

// Dedupe ledger so a quiz-completion email, weekly digest, or inactivity
// alert is sent at most once per (recipient, type, period/ref). Keeps the
// scheduler idempotent if it's invoked more than once in a window.
model NotificationLog {
  id     String   @id @default(cuid())
  userId String
  type   String // 'quiz_completed' | 'low_score' | 'weekly_digest' | 'inactivity'
  refKey String // quizId, ISO-week, or date bucket depending on type
  sentAt DateTime @default(now())

  @@unique([userId, type, refKey])
  @@index([userId])
}

// A successful Quizly Plus payment — one row per paid invoice. Recorded by the
// Stripe webhook (invoice.payment_succeeded). Powers the admin billing/receipts
// view and the per-parent payment history.
model Payment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeInvoiceId String?   @unique
  amount          Int       // smallest currency unit (e.g. cents)
  currency        String    @default("usd")
  status          String    @default("paid")
  description     String    @default("Quizly Plus")
  receiptUrl      String?   // Stripe hosted invoice / receipt URL
  periodEnd       DateTime?
  paidAt          DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([paidAt])
}

// Freemium funnel analytics — one row each time a free user hits a paywall
// (which gate) and each time a checkout/upgrade happens. Powers the admin
// conversion panel. Plain userId (no relation) to keep it append-only + cheap.
model PaywallEvent {
  id        String   @id @default(cuid())
  userId    String?
  reason    String   // 'free_daily_limit' | 'paid_feature_test' | 'paid_feature_children' | 'checkout_started' | 'upgraded'
  createdAt DateTime @default(now())

  @@index([reason, createdAt])
  @@index([userId])
}

// Lightweight in-app notification feed (currently billing events: a parent is
// notified the moment their payment lands). Shown in-app + cleared by reading.
// A browser/device Web Push subscription for a user. One row per device.
// Pushes are sent server-side via web-push; expired endpoints are pruned.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // 'plus_welcome' | 'payment_received' | …
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// =====================================================================
// Gamification
// =====================================================================

model Badge {
  code        String         @id
  name        String
  description String
  icon        String
  earned      StudentBadge[]
}

model StudentBadge {
  id        String   @id @default(cuid())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeCode String
  badge     Badge    @relation(fields: [badgeCode], references: [code])
  earnedAt  DateTime @default(now())
  context   String?  // JSON

  @@unique([studentId, badgeCode])
}

model XPLog {
  id        String   @id @default(cuid())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Which quiz produced this XP (null for non-quiz grants). Lets the results
  // screen reconstruct the exact itemized breakdown for one quiz.
  quizId    Int?
  quiz      Quiz?    @relation(fields: [quizId], references: [id], onDelete: SetNull)
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  // Composite index powers the weekly-XP leaderboard aggregate
  // (studentId IN (...) AND createdAt >= startOfWeek).
  @@index([studentId, createdAt])
  @@index([quizId])
}

// =====================================================================
// Admin: feature flags + audit log
// =====================================================================

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(true)
  value     String?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  metadata   String?  // JSON
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// =====================================================================
// Messaging
// =====================================================================

model Conversation {
  id            String                    @id @default(cuid())
  topicKey      String                    @unique
  studentId     Int?
  student       Student?                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt     DateTime                  @default(now())
  lastMessageAt DateTime                  @default(now())
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([lastMessageAt])
  @@index([studentId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Tutor session log + scheduling (v2.0 #8).
//
// A TutorSession records a tutoring session — either scheduled (future
// scheduledAt, status "scheduled") or logged after the fact (status
// "completed" with notes). Parents see a read-only view on the child page;
// tutors create/edit. focus + takeaways are free text the tutor fills in.
// ---------------------------------------------------------------------------

model TutorSession {
  id          String    @id @default(cuid())
  tutorId     String
  tutor       User      @relation("TutorSessions", fields: [tutorId], references: [id], onDelete: Cascade)
  studentId   Int
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // "scheduled" | "completed" | "cancelled"
  status      String    @default("scheduled")
  // When the session happens (scheduled) or happened (completed).
  scheduledAt DateTime
  durationMin Int       @default(30)
  // Tutor-authored. focus = what the session targets; notes/takeaways filled
  // after. Visible to the parent of the student.
  focus       String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([studentId])
  @@index([tutorId])
  @@index([scheduledAt])
}

// ---------------------------------------------------------------------------
// Custom homework (v2.0 #9).
//
// A tutor pins specific skills for a student to practise. Surfaces as a
// highlighted card on the child's home page. assignedSkillIds is a JSON array
// of Skill ids (kept denormalized + simple; a join table would be overkill
// for a short pinned list). status tracks lifecycle; dueAt is optional.
// ---------------------------------------------------------------------------

model HomeworkAssignment {
  id              String    @id @default(cuid())
  tutorId         String
  tutor           User      @relation("TutorHomework", fields: [tutorId], references: [id], onDelete: Cascade)
  studentId       Int
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title           String
  instructions    String?
  // JSON-encoded array of Skill ids. SQLite has no native JSON type, so this
  // is TEXT and parsed in code (same convention as ParentalSettings).
  assignedSkillIds String   @default("[]")
  dueAt           DateTime?
  // "active" | "completed" | "archived"
  status          String    @default("active")
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([studentId, status])
  @@index([tutorId])
}

// ---------------------------------------------------------------------------
// Secure parent→student account linking (v2.1 self-serve registration).
//
// A parent generates a one-time, time-limited claim code for one of their
// children. The student redeems it during self-signup to attach their new
// login to that pre-existing child profile. We store only a SHA-256 hash of
// the code (plaintext shown to the parent once); single-use via claimedAt;
// expires via expiresAt. One active code per child (regenerating overwrites).
// ---------------------------------------------------------------------------

model StudentClaimCode {
  id         String    @id @default(cuid())
  studentId  Int       @unique
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  codeHash   String    // sha256(plaintext); plaintext never stored
  expiresAt  DateTime
  claimedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([codeHash])
}
